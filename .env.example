# Puerto local (Railway inyecta el suyo automáticamente en producción)
PORT=3000

# Secreto para firmar los JWT de organizaciones y admins. Usa un valor largo
# y aleatorio distinto en cada ambiente.
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# URL pública del backend una vez desplegado (Railway → Settings → Networking).
# Se usa para armar back_urls y notification_url de Mercado Pago.
APP_BASE_URL=https://tu-servicio.up.railway.app

# --- Mercado Pago ---
# Access Token de producción o de prueba (Panel de Desarrolladores > Credenciales)
MP_ACCESS_TOKEN=
# Opcional: si no se define, se arma como {APP_BASE_URL}/api/pagos/webhook
MP_NOTIFICATION_URL=
# Public Key de Mercado Pago. Este backend no la usa (el checkout es 100%
# redirect a Checkout Pro — no hay ningún SDK de Mercado Pago corriendo en
# el navegador): se documenta acá solo para tenerla a mano si en algún
# momento se agrega un checkout embebido (Bricks) que sí la necesite.
MP_PUBLIC_KEY=

# --- Base de datos ---
# En Railway con el plugin de MySQL conectado, estas variables las inyecta
# Railway automáticamente (MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD,
# MYSQLDATABASE) y no hace falta declararlas acá. Estas son solo para correr
# el proyecto en local contra un MySQL propio.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=huayca

# --- Seed inicial (scripts/seed.js) ---
SEED_ADMIN_EMAIL=admin@huayca.cl
SEED_ADMIN_PASSWORD=CambiaEstaClave2026!
SEED_ORG_EMAIL=demo@colegiolosandes.cl
SEED_ORG_PASSWORD=CambiaEstaClave2026!

# Habilita GET /api/bootstrap/migrate y /api/bootstrap/seed (protegidas por
# este token) para poder aplicar el schema y cargar el seed desde el
# navegador cuando no hay acceso a una terminal ni a Railway CLI. Sin esta
# variable, esas dos rutas responden 404. Bórrala (o cámbiala) una vez que
# ya no la necesites.
BOOTSTRAP_TOKEN=
